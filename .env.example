# Copy this file to .env and fill in real values before running
# `podman-compose up`. Never commit the real .env file.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_TIME_ZONE=Asia/Kathmandu

# --- Database (MySQL container) ---
DB_ENGINE=mysql
DB_NAME=codelearn
DB_USER=codelearn
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DB_HOST=db
DB_PORT=3306

# --- Code runner service ---
# Internal address of the isolated code-runner container. Leave unset
# (comment out) to fall back to in-process execution inside the web
# container instead — useful for a smaller single-container deployment.
CODE_RUNNER_URL=http://code-runner:6000
